diff --git a/src/endpoint_validation.h b/src/endpoint_validation.h
new file mode 100644
index 0000000..84c7abb
--- /dev/null
+++ b/src/endpoint_validation.h
@@ -0,0 +1,74 @@
+#ifndef ENDPOINT_VALIDATION_H
+#define ENDPOINT_VALIDATION_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace EndpointValidation
+{
+constexpr size_t MAX_HOST_LENGTH = 253;
+constexpr size_t MAX_PATH_LENGTH = 191;
+
+inline bool validHost(const char *host)
+{
+  if (!host || !*host || std::strlen(host) > MAX_HOST_LENGTH)
+    return false;
+  size_t labelLength = 0;
+  char previous = '.';
+  for (const char *p = host; *p; ++p)
+  {
+    const char c = *p;
+    const bool alphanumeric = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
+    if (c == '.')
+    {
+      if (!labelLength || previous == '-')
+        return false;
+      labelLength = 0;
+    }
+    else
+    {
+      if (!alphanumeric && c != '-')
+        return false;
+      if ((!labelLength && c == '-') || ++labelLength > 63)
+        return false;
+    }
+    previous = c;
+  }
+  return labelLength != 0 && previous != '-';
+}
+
+inline bool parsePort(const char *text, uint16_t &port)
+{
+  if (!text || !*text)
+    return false;
+  uint32_t value = 0;
+  for (const char *p = text; *p; ++p)
+  {
+    if (*p < '0' || *p > '9')
+      return false;
+    value = value * 10 + (*p - '0');
+    if (value > 65535)
+      return false;
+  }
+  if (!value)
+    return false;
+  port = static_cast<uint16_t>(value);
+  return true;
+}
+
+inline bool validPath(const char *path)
+{
+  if (!path || path[0] != '/' || std::strlen(path) > MAX_PATH_LENGTH)
+    return false;
+  for (const char *p = path; *p; ++p)
+  {
+    const unsigned char c = static_cast<unsigned char>(*p);
+    if (c <= 32 || c >= 127 || c == '?' || c == '#' || c == '\\' || c == '"' || c == '<' || c == '>')
+      return false;
+  }
+  return true;
+}
+} // namespace EndpointValidation
+
+#endif
