+++ b/src/server_config.h
@@ -0,0 +1,21 @@
+#ifndef SERVER_CONFIG_H
+#define SERVER_CONFIG_H
+
+#include <Arduino.h>
+#include <cstdint>
+
+namespace ServerConfig
+{
+struct Endpoint
+{
+  String host;
+  uint16_t port;
+  String path;
+};
+
+// Empty portal fields reset their individual values to the built-in defaults.
+Endpoint load();
+bool save(String host, String port, String path);
+} // namespace ServerConfig
+
+#endif
diff --git a/src/server_config.cpp b/src/server_config.cpp
new file mode 100644
index 0000000..cf82154
--- /dev/null
+++ b/src/server_config.cpp
@@ -0,0 +1,65 @@
+#include "server_config.h"
+
+#include "endpoint_validation.h"
+#include <ArduinoJson.h>
+#include <Preferences.h>
+
+extern const char *const NVS_NAMESPACE;
+
+namespace ServerConfig
+{
+static const char *DEFAULT_HOST = "cdn.zivyobraz.eu";
+static const char *DEFAULT_PATH = "/index.php";
+#ifdef USE_CLIENT_HTTP
+static constexpr uint16_t DEFAULT_PORT = 80;
+#else
+static constexpr uint16_t DEFAULT_PORT = 443;
+#endif
+
+Endpoint load()
+{
+  Endpoint endpoint{DEFAULT_HOST, DEFAULT_PORT, DEFAULT_PATH};
+  Preferences prefs;
+  if (!prefs.begin(NVS_NAMESPACE, true))
+    return endpoint;
+  const String stored = prefs.getString("server_endpoint", "");
+  prefs.end();
+  JsonDocument doc;
+  if (!stored.isEmpty() && !deserializeJson(doc, stored))
+  {
+    endpoint.host = doc["host"].as<String>();
+    endpoint.port = doc["port"].as<uint16_t>();
+    endpoint.path = doc["path"].as<String>();
+  }
+  return endpoint;
+}
+
+bool save(String host, String port, String path)
+{
+  host.trim();
+  port.trim();
+  path.trim();
+  if (host.isEmpty())
+    host = DEFAULT_HOST;
+  if (path.isEmpty())
+    path = DEFAULT_PATH;
+  uint16_t portNumber = DEFAULT_PORT;
+  if (!EndpointValidation::validHost(host.c_str()) || !EndpointValidation::validPath(path.c_str()) ||
+      (!port.isEmpty() && !EndpointValidation::parsePort(port.c_str(), portNumber)))
+    return false;
+
+  Preferences prefs;
+  if (!prefs.begin(NVS_NAMESPACE))
+    return false;
+  JsonDocument doc;
+  doc["host"] = host;
+  doc["port"] = portNumber;
+  doc["path"] = path;
+  String encoded;
+  serializeJson(doc, encoded);
+  // One NVS value keeps host, port and path together across power loss.
+  const bool saved = prefs.putString("server_endpoint", encoded) != 0;
+  prefs.end();
+  return saved;
+}
+} // namespace ServerConfig
diff --git a/tests/endpoint_validation_test.cpp b/tests/endpoint_validation_test.cpp
new file mode 100644
index 0000000..5619161
--- /dev/null
+++ b/tests/endpoint_validation_test.cpp
@@ -0,0 +1,35 @@
+#include "../src/endpoint_validation.h"
+#include <cassert>
+#include <string>
+
+int main()
+{
+  using namespace EndpointValidation;
+  for (const char *host : {"cdn.zivyobraz.eu", "homeassistant.local", "192.168.1.10", "ha", "my-server.local"})
+    assert(validHost(host));
+  for (const char *host : {"", "http://ha", "ha:8123", "user@ha", "ha/path", "ha\r\nInjected", "-ha", "ha-", ".ha",
+                           "ha.", "ha..local", "[::1]"})
+    assert(!validHost(host));
+  assert(!validHost(std::string(64, 'a').c_str()));
+  assert(!validHost(
+    (std::string(63, 'a') + "." + std::string(63, 'a') + "." + std::string(63, 'a') + "." + std::string(63, 'a'))
+      .c_str()));
+  assert(!validHost(nullptr));
+
+  uint16_t port = 0;
+  assert(parsePort("80", port) && port == 80);
+  assert(parsePort("8123", port) && port == 8123);
+  assert(parsePort("65535", port) && port == 65535);
+  for (const char *text : {"", "0", "65536", "-1", "+80", "80x", "80\r\n", "999999999999999999"})
+    assert(!parsePort(text, port));
+  assert(!parsePort(nullptr, port));
+
+  for (const char *path : {"/", "/index.php", "/api/eink/image", "/my%20image"})
+    assert(validPath(path));
+  for (const char *path :
+       {"", "index.php", "//ha?x=y", "/image#fragment", "/with space", "/a\r\nInjected", "/a\\b", "/\"", "/<x>"})
+    assert(!validPath(path));
+  assert(validPath(("/" + std::string(MAX_PATH_LENGTH - 1, 'a')).c_str()));
+  assert(!validPath(("/" + std::string(MAX_PATH_LENGTH, 'a')).c_str()));
+  assert(!validPath(nullptr));
+}
